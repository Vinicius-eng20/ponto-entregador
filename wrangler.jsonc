{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Mesmo nome do antigo Worker proxy do Render: o deploy substitui o proxy e
  // mantém a URL ponto-entregador.<subdomínio>.workers.dev.
  // Para validar antes da virada: npx wrangler deploy --name ponto-entregador-v2
  "name": "ponto-entregador",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Necessário para o driver "pg" (Postgres) e o "bcryptjs".
  "compatibility_flags": ["nodejs_compat"],

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Substituir pelo id gerado com (cache desligado: o app lê logo depois de gravar):
      //   npx wrangler hyperdrive create ponto-entregador --caching-disabled --connection-string="<URL do Neon>"
      "id": "6e0d27537369415fb18a17c806fc44fb",
      // Banco usado pelo `wrangler dev` fora do Docker. No Docker, a variável
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE substitui este valor.
      "localConnectionString": "postgresql://postgres:postgres@localhost:5433/ponto"
    }
  ],

  // Landing, páginas e CSS/JS. Só as rotas listadas em run_worker_first passam
  // pelo Worker (API e páginas que dependem de login); o resto é servido direto,
  // sem custo de CPU nem de requisição do Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/app", "/login", "/cadastro", "/health"]
  },

  "vars": {
    "TZ_APP": "America/Sao_Paulo",
    // Custo do bcrypt. Ver docs/migracao-workers.md sobre o limite de CPU do plano gratuito.
    "BCRYPT_COST": "10"
  },
  // SESSION_SECRET é segredo: local em .dev.vars, produção com `wrangler secret put SESSION_SECRET`.

  // Logs estruturados no painel da Cloudflare (Workers Logs).
  "observability": { "enabled": true }
}
