# Copie este arquivo para .env e ajuste os valores

# development | testing | production
FLASK_ENV=development

# Troque por uma chave aleatória e secreta em produção
SECRET_KEY=troque-esta-chave-por-uma-aleatoria

# String de conexão do Postgres
# Local (docker compose): postgresql://postgres:postgres@db:5432/ponto
# Produção (Neon): postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@db:5432/ponto

TZ=America/Sao_Paulo

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
